{
  "name": "@jacoobia/contextify",
  "version": "1.0.0",
  "description": "A lightweight vanilla JavaScript context menu library with support for any icon library.",
  "author": "Jacob Hampton",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacoobia/Contextify.git"
  },
  "type": "module",
  "main": "./dist/contextify.cjs",
  "module": "./dist/contextify.js",
  "types": "./dist/contextify.d.ts",
  "unpkg": "./dist/contextify.global.js",
  "jsdelivr": "./dist/contextify.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/contextify.d.ts",
        "default": "./dist/contextify.js"
      },
      "require": {
        "types": "./dist/contextify.d.cts",
        "default": "./dist/contextify.cjs"
      }
    },
    "./themes/*": "./themes/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "themes"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  }
}
